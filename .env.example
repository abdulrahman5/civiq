# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Postgres connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgres://sma:sma@localhost:5432/sma

# Long random string used to sign portal login sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Address of the Civiq Portal, e.g. https://portal.theciviq.com.ng. Once set, that host only serves the
# portal and /admin on every legislator's domain redirects there. Leave empty until the portal
# domain exists: the portal then runs on the deployment's own address.
PORTAL_URL=

# Root domain for preview addresses: <slug>.theciviq.com.ng shows that legislator's site before their own
# domain is live. Needs a wildcard *.theciviq.com.ng domain on the Vercel project.
PLATFORM_ROOT_DOMAIN=

# Which site localhost and *.vercel.app addresses show. Empty = the first site created.
# Locally, any site is also reachable at http://<slug>.localhost:3000
DEFAULT_TENANT_SLUG=

# Vercel Blob (photo storage). Added automatically when you connect a Blob store in Vercel.
# Leave empty locally: uploads are then saved to the ./media folder instead.
BLOB_READ_WRITE_TOKEN=

# Resend (password-reset emails and contact-form alerts). Leave empty locally: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Civiq

# Newsletters. RESEND_WEBHOOK_SECRET (whsec_...) comes from Resend -> Webhooks; CRON_SECRET is any long random string.
# NEWSLETTER_DRY_RUN=1 records sends without emailing anyone (local testing only).
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
NEWSLETTER_CRON_FREQUENT=
NEWSLETTER_DRY_RUN=

# Connect legislators' domains from the portal (Vercel access token, project ID, and team ID if the project is in a team).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
